<style id="osint-ip-menu-style">
.osint-ip-link{
  display:block;
  margin:16px 0;
  padding:14px 16px;
  border-radius:12px;
  background:#111722;
  border:1px solid #252d3a;
  color:inherit;
  text-decoration:none;
  font-weight:700;
}
</style>

</body>
</html>
