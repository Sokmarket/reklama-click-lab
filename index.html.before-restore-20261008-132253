<!doctype html>
<html lang="tr">
<head>
<meta charset="utf-8">
<meta name="viewport"
      content="width=device-width,initial-scale=1,viewport-fit=cover">

<meta name="theme-color" content="#ffffff">
<link rel="manifest" href="./manifest.webmanifest">

<title>İNDİRİM KUPONU</title>

<style>
*{
  box-sizing:border-box;
  -webkit-tap-highlight-color:transparent;
}

html,
body{
  margin:0;
  width:100%;
  min-height:100%;
}

body{
  min-height:100dvh;
  background:#fff;
  font-family:
    Inter,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    Roboto,
    Arial,
    sans-serif;
}

.page{
  width:100%;
  min-height:100dvh;

  display:flex;
  flex-direction:column;
  align-items:center;

  padding:
    max(12px,env(safe-area-inset-top))
    12px
    max(18px,env(safe-area-inset-bottom));
}

.content{
  width:100%;
  max-width:900px;

  display:flex;
  flex-direction:column;
  align-items:center;
}

.image-link{
  display:block;
  width:100%;
  text-decoration:none;
  line-height:0;
}

.main-image{
  display:block;

  width:100%;
  height:auto;

  max-height:calc(100dvh - 105px);

  object-fit:contain;
  object-position:center;

  border-radius:18px;
}

.coupon-button{
  display:flex;

  width:100%;
  min-height:64px;

  margin-top:12px;

  align-items:center;
  justify-content:center;

  padding:16px 20px;

  border-radius:16px;

  background:#111;
  color:#fff;

  text-decoration:none;

  font-size:18px;
  line-height:1;
  font-weight:900;

  letter-spacing:.02em;

  box-shadow:
    0 8px 24px rgba(0,0,0,.20);

  transition:
    transform .12s ease,
    box-shadow .12s ease;
}

.coupon-button:active{
  transform:scale(.975);

  box-shadow:
    0 4px 12px rgba(0,0,0,.18);
}

.coupon-button:focus-visible{
  outline:3px solid #ffd400;
  outline-offset:3px;
}

@media(min-width:700px){

  .page{
    padding:30px;
  }

  .main-image{
    max-height:none;
  }

  .coupon-button{
    min-height:70px;
    font-size:20px;
  }
}
</style>
<meta property="og:type" content="website">
<meta property="og:title" content="İNDİRİM KUPONU">
<meta property="og:image" content="https://arzuoglumammad-star.github.io/reklama-click-lab/reklam.png">
<meta property="og:image:type" content="image/png">
<meta property="og:image:alt" content="İNDİRİM KUPONU">
<meta property="og:url" content="https://arzuoglumammad-star.github.io/reklama-click-lab/">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="İNDİRİM KUPONU">
<meta name="twitter:image" content="https://arzuoglumammad-star.github.io/reklama-click-lab/reklam.png">
</head>

<body>

<main class="page">

  <section class="content"
           aria-label="İndirim kuponu">

    <!-- Görsel -->
    <a
      class="image-link"
      href="https://www.sokmarket.com.tr/"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="İndirim kuponuna git">

      <img
        class="main-image"
        src="./reklam.png"
        alt="İNDİRİM KUPONU"
        width="1200"
        height="630"
        loading="eager"
        fetchpriority="high">

    </a>

    <!-- METNİN KENDİSİ BUTON + LİNK -->
    <a class="coupon-button"
       href="https://www.sokmarket.com.tr/"
       target="_blank"
       rel="noopener noreferrer">İNDİRİM KUPONU</a>

  </section>

</main>

<script>
"use strict";

if ("serviceWorker" in navigator) {
  window.addEventListener("load", function () {
    navigator.serviceWorker
      .register("./sw.js?v=7")
      .catch(function () {});
  });
}
</script>

</body>
</html>
