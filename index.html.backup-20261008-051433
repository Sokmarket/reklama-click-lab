<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">

<meta name="viewport"
      content="width=device-width,
               initial-scale=1,
               maximum-scale=1,
               user-scalable=no,
               viewport-fit=cover">

<title>İndirim Kuponu</title>

<meta name="description"
      content="İndirim Kuponu">

<meta name="theme-color"
      content="#000000">

<style>
*{
  box-sizing:border-box;
  -webkit-tap-highlight-color:transparent;
}

html,
body{
  width:100%;
  height:100%;
  margin:0;
  padding:0;
  overflow:hidden;
  background:#000;
}

body{
  font-family:
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    Roboto,
    Arial,
    sans-serif;

  display:flex;
  align-items:center;
  justify-content:center;
}

/* ==================================================
   ANA REKLAM ALANI
   ================================================== */

#adPage{
  position:fixed;
  inset:0;

  width:100vw;
  height:100dvh;

  display:flex;
  align-items:center;
  justify-content:center;

  background:#000;
}

/*
   GÖRSEL ARTIK LINK DEĞİL.
   BUTTON MANTIĞIYLA ÇALIŞIYOR.
*/

#adButton{
  position:relative;

  width:100vw;
  height:100dvh;

  margin:0;
  padding:0;

  border:0;
  outline:0;

  background:#000;

  display:flex;
  align-items:center;
  justify-content:center;

  cursor:pointer;

  appearance:none;
  -webkit-appearance:none;

  touch-action:manipulation;
}

#adButton img{
  display:block;

  width:100%;
  height:100%;

  object-fit:contain;
  object-position:center;

  user-select:none;
  -webkit-user-select:none;

  -webkit-user-drag:none;
  pointer-events:none;
}

/* ==================================================
   TAM EKRAN GALERİ
   ================================================== */

#fullscreenViewer{
  position:fixed;

  inset:0;

  width:100vw;
  height:100dvh;

  z-index:999999;

  display:none;

  align-items:center;
  justify-content:center;

  background:#000;

  overflow:hidden;

  touch-action:none;
}

#fullscreenViewer.open{
  display:flex;
}

#fullscreenImage{
  display:block;

  width:100vw;
  height:100dvh;

  max-width:100vw;
  max-height:100dvh;

  object-fit:contain;
  object-position:center;

  user-select:none;
  -webkit-user-select:none;

  -webkit-user-drag:none;

  pointer-events:none;
}

/* ==================================================
   KAPAT BUTTON
   ================================================== */

#closeViewer{
  position:absolute;

  z-index:1000000;

  top:
    max(
      16px,
      env(safe-area-inset-top)
    );

  right:
    max(
      16px,
      env(safe-area-inset-right)
    );

  width:48px;
  height:48px;

  padding:0;

  border:1px solid rgba(255,255,255,.30);

  border-radius:50%;

  background:rgba(0,0,0,.65);

  color:#fff;

  font-size:30px;
  line-height:46px;

  text-align:center;

  cursor:pointer;

  appearance:none;
  -webkit-appearance:none;

  touch-action:manipulation;
}

/* ==================================================
   ERİŞİLEBİLİRLİK
   ================================================== */

button:focus{
  outline:none;
}

/* Viewer açıldığında ana sayfa hareket etmez */
body.viewer-open{
  overflow:hidden;
  position:fixed;
  width:100%;
  height:100%;
}
</style>
</head>

<body>

<!-- =================================================
     ANA REKLAM
     ================================================= -->

<main id="adPage">

  <!--
       BU BİR LINK DEĞİL.
       URL'YE GİTMEZ.
       TIKLANINCA JAVASCRIPT İLE TAM EKRAN AÇAR.
  -->

  <button
    id="adButton"
    type="button"
    aria-label="İndirim Kuponu görselini tam ekran aç">

    <img
      src="./reklam.png"
      alt="İndirim Kuponu"
      draggable="false">

  </button>

</main>


<!-- =================================================
     TAM EKRAN GÖRÜNTÜLEYİCİ
     ================================================= -->

<section
  id="fullscreenViewer"
  aria-hidden="true"
  role="dialog"
  aria-label="İndirim Kuponu tam ekran görüntüleyici">

  <button
    id="closeViewer"
    type="button"
    aria-label="Görseli kapat"
    title="Kapat">

    ×

  </button>

  <img
    id="fullscreenImage"
    src="./reklam.png"
    alt="İndirim Kuponu tam ekran"
    draggable="false">

</section>


<script>
"use strict";

/*
======================================================
 REKLAM GÖRSELİ — BUTTON / FULLSCREEN MOTORU
======================================================
*/

const adButton =
  document.getElementById("adButton");

const viewer =
  document.getElementById("fullscreenViewer");

const fullscreenImage =
  document.getElementById("fullscreenImage");

const closeViewer =
  document.getElementById("closeViewer");


/*
======================================================
 TAM EKRAN AÇ
======================================================
*/

function openViewer(event){

  /*
     Link olmadığı için URL değişmez.
     Her ihtimale karşı varsayılan davranışı durdur.
  */

  if(event){
    event.preventDefault();
    event.stopPropagation();
  }

  viewer.classList.add("open");

  viewer.setAttribute(
    "aria-hidden",
    "false"
  );

  document.body.classList.add(
    "viewer-open"
  );

  /*
     Tarayıcının gerçek Fullscreen API'sini
     zorlamıyoruz.

     Böylece adres çubuğu / tarayıcı
     navigasyonu ile uğraşmıyoruz.

     Viewer zaten viewport'un tamamını
     kaplıyor.
  */

  closeViewer.focus({
    preventScroll:true
  });
}


/*
======================================================
 KAPAT
======================================================
*/

function closeFullscreen(event){

  if(event){
    event.preventDefault();
    event.stopPropagation();
  }

  viewer.classList.remove("open");

  viewer.setAttribute(
    "aria-hidden",
    "true"
  );

  document.body.classList.remove(
    "viewer-open"
  );

  adButton.focus({
    preventScroll:true
  });
}


/*
======================================================
 GÖRSELE DOKUN
======================================================
*/

adButton.addEventListener(
  "click",
  openViewer,
  {passive:false}
);


/*
======================================================
 KAPAT BUTTON
======================================================
*/

closeViewer.addEventListener(
  "click",
  closeFullscreen,
  {passive:false}
);


/*
======================================================
 SİYAH ALANA DOKUNARAK KAPAT
======================================================
*/

viewer.addEventListener(
  "click",
  function(event){

    if(event.target === viewer){
      closeFullscreen(event);
    }

  },
  {passive:false}
);


/*
======================================================
 ESC
======================================================
*/

document.addEventListener(
  "keydown",
  function(event){

    if(
      event.key === "Escape" &&
      viewer.classList.contains("open")
    ){

      closeFullscreen(event);

    }

  }
);


/*
======================================================
 ANDROID / TARAYICI GERİ TUŞU
======================================================
*/

history.replaceState(
  {adPage:true},
  "",
  window.location.href
);

history.pushState(
  {adViewer:false},
  "",
  window.location.href
);

window.addEventListener(
  "popstate",
  function(){

    if(
      viewer.classList.contains("open")
    ){

      closeFullscreen();

      history.pushState(
        {adViewer:false},
        "",
        window.location.href
      );

    }

  }
);


/*
======================================================
 SAĞ TIK / UZUN BASMA MENÜSÜ
======================================================
*/

fullscreenImage.addEventListener(
  "contextmenu",
  function(event){
    event.preventDefault();
  }
);

adButton.addEventListener(
  "contextmenu",
  function(event){
    event.preventDefault();
  }
);

</script>

</body>
</html>
